# URL Dasar API Backend
# 1. Jika Backend dan Frontend satu domain (misal: domain.com dan domain.com/api):
VITE_API_BASE_URL=/api

# 2. Jika Backend di subfolder (misal cPanel: domain.com/backend_donasi/api):
# VITE_API_BASE_URL=/backend_donasi/api

# 3. Jika Backend di subdomain berbeda (misal: api.domain.com/api):
# VITE_API_BASE_URL=https://api.domain.com/api
